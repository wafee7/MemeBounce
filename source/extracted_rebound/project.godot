; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[_global_script_classes]

Billboard={
"base": &"Node2D",
"class": &"Billboard",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/billboard.gd"
}
BouncePad={
"base": &"Node2D",
"class": &"BouncePad",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/bounce_pad.gd"
}
CameraRig={
"base": &"Camera2D",
"class": &"CameraRig",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/camera_rig.gd"
}
Door={
"base": &"StaticBody2D",
"class": &"Door",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/door.gd"
}
Echo={
"base": &"Node2D",
"class": &"Echo",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/echo.gd"
}
ExitPortal={
"base": &"Node2D",
"class": &"ExitPortal",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/exit_portal.gd"
}
Flyer={
"base": &"Node2D",
"class": &"Flyer",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/flyer.gd"
}
Hud={
"base": &"CanvasLayer",
"class": &"Hud",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/hud.gd"
}
Level={
"base": &"Node2D",
"class": &"Level",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/level.gd"
}
LevelBackground={
"base": &"Node2D",
"class": &"LevelBackground",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/level_background.gd"
}
Player={
"base": &"CharacterBody2D",
"class": &"Player",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/player.gd"
}
PressurePlate={
"base": &"Node2D",
"class": &"PressurePlate",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/pressure_plate.gd"
}
TileLayer={
"base": &"Node2D",
"class": &"TileLayer",
"icon": "",
"language": &"GDScript",
"path": "res://scripts/tile_layer.gd"
}

[application]

config/name="RE:BOUND"
config/description="Every failure changes the world."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0627451, 0.0941176, 0.152941, 1)
boot_splash/show_image=false
config/icon="res://assets/sprites/icon.png"

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/mode=3
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/size/mode.web=0

[gui]

theme/custom="res://assets/fonts/ui_theme.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0627451, 0.0941176, 0.152941, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
